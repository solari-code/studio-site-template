# Optional: the site runs without any env file.
# To send contact-form mail, copy this to .env.local and fill in real values: cp .env.example .env.local

# Resend (contact form)
RESEND_API_KEY=re_placeholder
NOTIFICATION_EMAIL=you@example.com

# Umami analytics (optional; leave the ID empty to disable tracking)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
